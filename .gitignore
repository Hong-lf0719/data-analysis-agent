# 敏感文件 — 绝对不上传
.env
*.env

# 测试数据（sample 和 fixtures 需要上传）
*.xlsx

# 大数据文件 — 仅保留 samples 小样本
data/raw/
data/clean/
data/real/

# 验证产物（含数据/图表，不上传）
validation/

# 输出产物
*.png
*.jpg
# 但文档里的真实演示产物要进仓库（README 首屏用）
!docs/screenshots/*.png
*_report.md
analysis_report.md
analysis_report_*.md
outputs/

# 临时文件
_tmp_upload.csv
_tmp_*
tests/.last_run.txt

# WorkBuddy 工作目录（本地专用，不上传）
.workbuddy/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

